# =============================================================================
# SatQuery AI — Git Ignore Configuration
# =============================================================================

# Python Bytecode & Cache
**/__pycache__/
__pycache__/
**/*.py[cod]
*.py[cod]
**/*$py.class
*$py.class
**/*.pyo
**/*.pyd

# Virtual Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Large datasets & raw data
data/bigearthnet_raw/
data/raw/
data/bigearthnet_subset/images/
data/bigearthnet_subset/sar/
*.tar.gz
*.zip
*.tar

# PyTorch, Hugging Face Checkpoints & Model Weights
*.pt
*.pth
*.bin
*.safetensors
*.onnx
checkpoints/*/
!checkpoints/**/.gitkeep
**/checkpoints/*
!**/checkpoints/**/.gitkeep

# Generated Outputs & Cache from Inference / Tests
**/outputs/**/vqa/*
**/outputs/**/captioning/*
**/outputs/**/grounding/masks/*
**/outputs/**/grounding/overlays/*
**/outputs/**/grounding/bboxes/*
**/outputs/logs/*
**/outputs/reports/*
**/outputs/rs_training_samples/*
# SAR test images are auto-generated by create_sample_sar.py — exclude large binaries
**/outputs/test_images/sar/*.png
**/outputs/test_images/sar/*.tif
!**/outputs/**/.gitkeep

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Node / Frontend Artifacts
node_modules/
dist/
build/
.next/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
_quarantine/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Data and Outputs
data/
outputs/
*.tif
*.png
*.jpg
*.jpeg

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
