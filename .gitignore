# =============================================================================
# SatQuery AI — Git Ignore Configuration
# =============================================================================

# Python Bytecode & Cache
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.pyo
**/*.pyd

# Virtual Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# PyTorch, Hugging Face Checkpoints & Model Weights
*.pt
*.pth
*.bin
*.safetensors
*.onnx
checkpoints/*/
!checkpoints/**/.gitkeep
**/checkpoints/*
!**/checkpoints/**/.gitkeep

# Whitelist Person 2 Remote-Sensing LoRA Adapter Checkpoints (Step 5)
!**/checkpoints/p2_rs_lora/
!**/checkpoints/p2_rs_lora/**
!**/checkpoints/p2_rs_lora/*.bin
!**/checkpoints/p2_rs_lora/*.safetensors
!**/checkpoints/p2_rs_lora/*.json
!**/checkpoints/p2_rs_lora/*.txt

# Generated Outputs & Cache from Inference / Tests
**/outputs/**/vqa/*
**/outputs/**/captioning/*
**/outputs/**/grounding/masks/*
**/outputs/**/grounding/overlays/*
**/outputs/**/grounding/bboxes/*
**/outputs/logs/*
**/outputs/reports/*
**/outputs/rs_training_samples/*
# Test images are auto-generated at runtime — never commit them
**/outputs/test_images/sar/*.png
**/outputs/test_images/sar/*.tif
**/outputs/test_images/optical/*.png
**/outputs/test_images/optical/*.tif
!**/outputs/**/.gitkeep

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Node / Frontend Artifacts
node_modules/
dist/
build/
.next/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
